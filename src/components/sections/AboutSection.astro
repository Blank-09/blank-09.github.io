---
import { Card, CardContent } from "@/components/ui/card"
import { Badge } from "@/components/ui/badge"
import { Separator } from "@/components/ui/separator"
---

<section id="about" class="scroll-mt-16 py-20 px-6">
  <div class="mx-auto max-w-5xl">
    <div class="flex flex-col gap-12 md:flex-row md:gap-16">
      <!-- Bio -->
      <div class="flex flex-col gap-6 md:flex-1">
        <div class="flex flex-col gap-2">
          <p class="text-sm font-medium text-muted-foreground tracking-widest uppercase">
            About Me
          </p>
          <h2 class="font-heading text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
            Passionate about building things that scale.
          </h2>
        </div>
        <div class="flex flex-col gap-4 text-muted-foreground leading-relaxed">
          <p>
            I'm a full stack developer with a focus on Java Spring Boot microservices, Python data pipelines, and React frontends. I enjoy designing systems that are clean, performant, and maintainable.
          </p>
          <p>
            When I'm not coding, I'm usually exploring new frameworks, solving problems on LeetCode, or contributing to open source projects.
          </p>
        </div>
      </div>

      <Separator className="md:hidden" />

      <!-- Quick facts -->
      <div class="flex flex-col gap-4 md:w-72">
        <Card>
          <CardContent className="flex flex-col gap-4 pt-6">
            <div class="flex flex-col gap-1">
              <span class="text-xs font-medium text-muted-foreground uppercase tracking-wider">
                Specialization
              </span>
              <span class="text-sm text-foreground">Backend &amp; Full Stack</span>
            </div>
            <Separator />
            <div class="flex flex-col gap-1">
              <span class="text-xs font-medium text-muted-foreground uppercase tracking-wider">
                Primary Stack
              </span>
              <div class="flex flex-wrap gap-1.5 mt-1">
                <Badge variant="secondary">Java</Badge>
                <Badge variant="secondary">Spring Boot</Badge>
                <Badge variant="secondary">Python</Badge>
                <Badge variant="secondary">React</Badge>
              </div>
            </div>
            <Separator />
            <div class="flex flex-col gap-1">
              <span class="text-xs font-medium text-muted-foreground uppercase tracking-wider">
                Open to
              </span>
              <span class="text-sm text-foreground">Full-time / Contract roles</span>
            </div>
          </CardContent>
        </Card>
      </div>
    </div>
  </div>
</section>
