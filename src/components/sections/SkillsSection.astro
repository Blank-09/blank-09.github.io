---
import {
  Card,
  CardHeader,
  CardTitle,
  CardContent,
} from "@/components/ui/card"
import { Badge } from "@/components/ui/badge"
import { skillGroups } from "@/data/skills"
---

<section id="skills" class="scroll-mt-16 py-20 px-6 bg-muted/30">
  <div class="mx-auto max-w-5xl flex flex-col gap-10">
    <div class="flex flex-col gap-2">
      <p class="text-sm font-medium text-muted-foreground tracking-widest uppercase">
        Tech Stack
      </p>
      <h2 class="font-heading text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        Skills &amp; Technologies
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
      {
        skillGroups.map((group) => (
          <Card>
            <CardHeader>
              <CardTitle>{group.category}</CardTitle>
            </CardHeader>
            <CardContent className="flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <Badge variant="secondary">{skill.name}</Badge>
              ))}
            </CardContent>
          </Card>
        ))
      }
    </div>
  </div>
</section>
