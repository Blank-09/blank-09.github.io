---
import Github from "@/assets/icon/github"
import Linkedin from "@/assets/icon/linkedin"

import { Button } from "@/components/ui/button"
import { Mail } from "lucide-react"
---

<section id="contact" class="scroll-mt-16 bg-muted/30 px-6 py-20">
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-8 text-center">
    <div class="flex flex-col gap-4">
      <p
        class="text-sm font-medium tracking-widest text-muted-foreground uppercase"
      >
        Get in Touch
      </p>
      <h2
        class="font-heading text-3xl font-bold tracking-tight text-foreground sm:text-4xl"
      >
        Let's Connect
      </h2>
      <p class="max-w-md text-muted-foreground">
        Whether you have a role in mind, a project idea, or just want to say hi
        — my inbox is open.
      </p>
    </div>

    <Button variant="default" size="lg" asChild>
      <a href="mailto:venkat.enggops@gmail.com">
        <Mail data-icon="inline-start" />
        Send an Email
      </a>
    </Button>

    <div class="flex gap-3">
      <Button variant="outline" size="icon" asChild>
        <a
          href="https://github.com/blank-09"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub profile"
        >
          <Github />
        </a>
      </Button>

      <Button variant="outline" size="icon" asChild>
        <a
          href="https://linkedin.com/in/priyanshu"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn profile"
        >
          <Linkedin />
        </a>
      </Button>

      <!-- LeetCode -->
      <Button variant="outline" size="icon" asChild>
        <a
          href="https://leetcode.com/blank-09"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LeetCode profile"
        >
          <svg
            viewBox="0 0 24 24"
            fill="currentColor"
            class="size-4"
            aria-hidden="true"
          >
            <path
              d="M13.483 0a1.374 1.374 0 0 0-.961.438L7.116 6.226l-3.854 4.126a5.266 5.266 0 0 0-1.209 2.104 5.35 5.35 0 0 0-.125.513 5.527 5.527 0 0 0 .062 2.362 5.83 5.83 0 0 0 .349 1.017 5.938 5.938 0 0 0 1.271 1.818l4.277 4.193.039.038c2.248 2.165 5.852 2.133 8.063-.074l2.396-2.392c.54-.54.54-1.414.003-1.955a1.378 1.378 0 0 0-1.951-.003l-2.396 2.392a3.021 3.021 0 0 1-4.205.038l-.02-.019-4.276-4.193c-.652-.64-.972-1.469-.948-2.263a2.68 2.68 0 0 1 .066-.523 2.545 2.545 0 0 1 .619-1.164L9.13 8.114c1.058-1.134 3.204-1.27 4.43-.278l3.501 2.831c.593.48 1.461.387 1.94-.207a1.384 1.384 0 0 0-.207-1.943l-3.5-2.831c-.8-.647-1.766-1.045-2.774-1.202l2.015-2.158A1.384 1.384 0 0 0 13.483 0zm-2.866 12.815a1.38 1.38 0 0 0-1.38 1.382 1.38 1.38 0 0 0 1.38 1.382H20.79a1.38 1.38 0 0 0 1.38-1.382 1.38 1.38 0 0 0-1.38-1.382z"
            ></path>
          </svg>
        </a>
      </Button>
    </div>
  </div>
</section>
