---
import Layout from "@/layouts/main.astro"
import ShapeGrid from "@/components/react-bits/ShapeGrid"
---

<Layout>
  <div class="relative h-screen">
    <ShapeGrid
      speed={0.5}
      squareSize={40}
      direction="diagonal"
      borderColor="#2F293A"
      hoverFillColor="#222"
      shape="square"
      hoverTrailAmount={0}
      direction="diagonal"
      size={40}
      shape="square"
      client:load
    />
  </div>
</Layout>
